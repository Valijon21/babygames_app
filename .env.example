# ==========================================
# Bolajon Platform — Environment Configuration
# ==========================================
# Copy this file to .env and adjust variables for your local development environment.
# NEVER commit the actual .env file or real secrets to version control!

# ------------------------------------------
# Django Backend Settings
# ------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=insecure-dev-key-change-in-production-only-abc123xyz789
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bolajon_db
POSTGRES_DB=bolajon_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------
# CORS & CSRF Settings
# ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------
# Redis / Cache (Optional for MVP local)
# ------------------------------------------
REDIS_URL=redis://localhost:6379/1

# ------------------------------------------
# Frontend Settings (Vite)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Bolajon"
